# Copy this file to .env.local for local dev, and add the same two variables in Vercel
# (Project → Settings → Environment Variables). Both are safe to expose in the browser:
# your data is protected by Row Level Security (see supabase/schema.sql).

# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: the name shown in greetings and reports (default: Tina)
# VITE_PRINCESS_NAME=Tina
